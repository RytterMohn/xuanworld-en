---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allTags = Array.from(new Set(posts.flatMap((p) => p.data.tags))).sort();
const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Posts" description="Technical articles on AI agents, Android internals, and security engineering.">
  <div class="article-header">
    <h1>Posts</h1>
    <p class="post-desc">Curated engineering deep dives and project write-ups in English.</p>
    {
      allTags.length > 0 && (
        <div class="tag-row" style="margin-top: 0.9rem;">
          {allTags.map((tag) => (
            <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
              #{tag}
            </a>
          ))}
        </div>
      )
    }
  </div>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li class="post-item">
          <a class="post-title" href={`/posts/${post.id}/`}>
            {post.data.title}
          </a>
          <div class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          </div>
          <p class="post-desc">{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <div class="tag-row">
              {post.data.tags.map((tag) => (
                <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
                  #{tag}
                </a>
              ))}
            </div>
          )}
        </li>
      ))
    }
  </ul>
</BaseLayout>
