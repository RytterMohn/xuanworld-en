---
import BaseLayout from '../layouts/BaseLayout.astro';
import { OSS_HIGHLIGHTS, PROJECTS } from '../site.config';
---

<BaseLayout title="Projects" description="Open-source projects and upstream security/systems contributions by RytterMohn.">
  <div class="article-header">
    <h1>Projects</h1>
    <p class="post-desc">Open-source work across mobile AI agents, Android security, reverse engineering, and LLM red teaming.</p>
  </div>

  <section class="section" style="margin-top: 0;">
    <div class="card-grid">
      {
        PROJECTS.map((p) => (
          <article class="card">
            <div class="card-top">
              <a class="card-title" href={p.repo} target="_blank" rel="noopener noreferrer">
                {p.name} ↗
              </a>
              <span class="card-pill">{p.highlight ? `${p.area} · ${p.highlight}` : p.area}</span>
            </div>
            <p>{p.summary}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Upstream Contributions</h2>
    </div>
    <ul class="oss-list">
      {
        OSS_HIGHLIGHTS.map((item) => (
          <li>
            <strong>
              <a href={item.url} target="_blank" rel="noopener noreferrer">
                {item.project}
              </a>
            </strong>{' '}
            (<code>{item.pr}</code>) — {item.note}
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
