---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = Array.from(new Set(posts.flatMap((p) => p.data.tags)));
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={`#${tag}`} description={`Posts tagged with #${tag}.`}>
  <div class="article-header">
    <h1>#{tag}</h1>
    <p class="post-desc">{posts.length} {posts.length === 1 ? 'post' : 'posts'} tagged with #{tag}.</p>
  </div>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li class="post-item">
          <a class="post-title" href={`/posts/${post.id}/`}>
            {post.data.title}
          </a>
          <div class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          </div>
          <p class="post-desc">{post.data.description}</p>
        </li>
      ))
    }
  </ul>

  <p style="margin-top: 2rem;">
    <a href="/posts">← Back to all posts</a>
  </p>
</BaseLayout>
